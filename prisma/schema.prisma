generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum MediaPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SocialPlatform {
  facebook
  instagram
  twitter
  linkedin
  tiktok
  youtube
  whatsapp
}

enum AiProvider {
  anthropic
  openai
  huggingface
}

enum PostStatus {
  pending
  published
  failed
  deleted
}

enum PostFormat {
  feed
  story
  reel
}

enum TokenType {
  SHORT_LIVED
  LONG_LIVED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  name        String?
  avatar      String?
  role        String    @default("editor") // admin, editor, viewer
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  // Relations
  socialPosts        SocialMediaPost[]
  socialAccounts     SocialMediaAccount[]
  socialIntegrations SocialMediaIntegration[]
  mediaPosts         MediaPost[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────
// SOCIAL MEDIA ACCOUNTS
// ─────────────────────────────────────────────

model SocialMediaAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform   String // website, facebook, instagram, tiktok, youtube, linkedin, x
  pageId     String
  pageName   String?
  pageAvatar String?
  meta       String?

  // Token management — supports short-lived and long-lived tokens
  accessToken         String? // Currently active token
  shortLivedToken     String?
  shortLivedExpiresAt DateTime?
  longLivedToken      String?
  longLivedExpiresAt  DateTime?
  tokenType           TokenType @default(LONG_LIVED)
  refreshToken        String?
  tokenExpiresAt      DateTime? // Deprecated: use specific *ExpiresAt fields

  oauthState String? // Temporary state for OAuth callback validation
  isActive   Boolean  @default(true)
  scopes     String[] @default([]) // granted OAuth scopes

  // Back-relation only — adds no column to this table.
  groupMemberships AccountGroupMember[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, platform, pageId])
  @@index([userId])
  @@index([platform])
  @@map("social_media_accounts")
}

// ─────────────────────────────────────────────
// SOCIAL MEDIA INTEGRATIONS (app-level credentials per platform)
// ─────────────────────────────────────────────

model SocialMediaIntegration {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform     String // website, facebook, instagram, tiktok, youtube, linkedin, x
  appId        String
  appSecretEnc String
  callbackUrl  String? // OAuth callback/redirect URI (environment-specific)
  syncedAt     DateTime?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, platform])
  @@index([userId])
  @@map("social_media_integrations")
}

// ─────────────────────────────────────────────
// SOCIAL MEDIA POSTS
// ─────────────────────────────────────────────

model SocialMediaPost {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source article (optional — set when post derives from a MediaPost)
  mediaPostId String?
  mediaPost   MediaPost? @relation(fields: [mediaPostId], references: [id], onDelete: SetNull)

  // Post identification
  platform String // facebook, instagram, twitter, linkedin, tiktok
  pageId   String
  postId   String? // ID returned from platform after publishing
  postUrl  String? // Live URL on the platform

  // Security - encrypted access token for re-posting or retrieving metrics
  accessTokenEnc String? // Encrypted platform access token

  // Content
  message     String?
  link        String?
  description String?
  picture     String?
  name        String?
  caption     String?
  tags        String[] @default([])

  // Media
  postFormat PostFormat? @default(feed)
  mediaType  String? // image, video, carousel
  mediaUrls  String[]    @default([])
  altText    String?

  // Scheduling
  scheduledAt DateTime? @db.Timestamptz()
  publishedAt DateTime? @db.Timestamptz()

  // Audience targeting (for boosted/ad posts)
  ageMin    Int?
  ageMax    Int?
  genders   Int[]    @default([])
  countries String[] @default([])
  regions   String[] @default([])
  cities    String[] @default([])
  interests String[] @default([])
  keywords  String[] @default([])

  // AI generation
  aiGenerated Boolean @default(false)
  aiProvider  String?
  aiModel     String?
  aiPrompt    String?

  // Status
  status       String  @default("pending") // pending, published, failed, deleted
  errorMessage String?
  retryCount   Int     @default(0)

  // Engagement metrics (synced periodically)
  likes             Int       @default(0)
  comments          Int       @default(0)
  shares            Int       @default(0)
  views             Int       @default(0)
  reach             Int       @default(0)
  impressions       Int       @default(0)
  lastMetricsUpdate DateTime?

  // Flexible metadata (JSON string)
  metadata String?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([publishedAt])
  @@index([aiGenerated])
  @@index([mediaPostId])
  @@map("social_media_posts")
}

// ─────────────────────────────────────────────
// SOCIAL MEDIA ANALYTICS
// ─────────────────────────────────────────────

model SocialMediaAnalytics {
  id     String @id @default(uuid())
  postId String

  date     DateTime @db.Date
  platform String

  // Volume metrics
  impressions Int @default(0)
  reaches     Int @default(0)
  engagements Int @default(0)
  clicks      Int @default(0)

  // Engagement breakdown
  likes    Int @default(0)
  comments Int @default(0)
  shares   Int @default(0)
  saves    Int @default(0)
  views    Int @default(0)

  // Audience insights (stored as JSON string arrays)
  topCountries    String[] @default([])
  topCities       String[] @default([])
  genderBreakdown String[] @default([])
  ageBreakdown    String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([postId, date])
  @@index([postId])
  @@index([platform])
  @@index([date])
  @@map("social_media_analytics")
}

// ─────────────────────────────────────────────
// N8N RAW ARTICLE INGESTION
// ─────────────────────────────────────────────

model N8nArticle {
  id              BigInt    @id @default(autoincrement())
  guid            String    @unique
  source_url      String
  source_headline String?
  source_summary  String?
  image_url       String?
  pub_date        DateTime? @db.Timestamptz()
  category        String?
  creator         String?

  // Processing status
  status           String  @default("draft") // draft, processing, published, skipped, failed
  processing_error String?
  is_featured      Boolean @default(false)

  // AI enhancement fields (populated by n8n WF2 when article is processed)
  slug         String?  @unique
  ai_generated Boolean  @default(false)
  tags         String[] @default([])
  read_time    Int      @default(1)

  /// Denormalized from ArticleReadEvent — unique devices, not raw pings.
  viewCount Int @default(0)
  readCount Int @default(0)

  // Relations
  mediaPosts     MediaPost[]
  generatedPosts N8nGeneratedPost[]
  readEvents     ArticleReadEvent[]

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  @@index([guid])
  @@index([source_url])
  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([created_at])
  @@map("n8n_articles")
}

// ─────────────────────────────────────────────
// N8N GENERATED SOCIAL POSTS
// ─────────────────────────────────────────────

model N8nGeneratedPost {
  id BigInt @id @default(autoincrement())

  // Source references
  n8nArticleId BigInt?
  n8nArticle   N8nArticle? @relation(fields: [n8nArticleId], references: [id], onDelete: SetNull)

  mediaPostId String?
  mediaPost   MediaPost? @relation(fields: [mediaPostId], references: [id], onDelete: SetNull)

  topic    String?
  platform String? // facebook, instagram, twitter, linkedin, tiktok, whatsapp

  // Facebook
  fb_post_id  String?
  fb_url      String?
  fb_content  String?
  fb_hashtags String?

  // Instagram
  insta_post_id  String?
  insta_url      String?
  insta_content  String?
  insta_hashtags String?

  // Twitter / X
  twitter_post_id String?
  twitter_url     String?
  twitter_content String?
  twitter_thread  String? // JSON array of tweet texts for threads

  // LinkedIn
  linkedin_post_id String?
  linkedin_url     String?
  linkedin_content String?

  // WhatsApp (via Notify)
  whatsapp_content     String?
  whatsapp_campaign_id String? // Notify campaign ID
  whatsapp_sent_at     DateTime? @db.Timestamptz()

  // Status
  status        String  @default("draft") // draft, queued, published, failed
  error_message String?

  created_at   DateTime  @default(now()) @db.Timestamptz()
  published_at DateTime? @db.Timestamptz()

  @@index([n8nArticleId])
  @@index([mediaPostId])
  @@index([platform])
  @@index([status])
  @@index([created_at])
  @@map("n8n_generated_posts")
}

// ─────────────────────────────────────────────
// MEDIA POST (published articles)
// ─────────────────────────────────────────────

model MediaPost {
  id String @id @default(uuid())

  // Author
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Source (raw ingested article this was generated from)
  n8nArticleId BigInt?
  n8nArticle   N8nArticle? @relation(fields: [n8nArticleId], references: [id], onDelete: SetNull)

  // Core content
  title   String
  slug    String  @unique
  content String // Full HTML body generated by Claude
  excerpt String? // 2–3 sentence summary for cards + OG

  // Media
  cover_image    String? // Final cover image URL
  cover_alt      String? // Alt text for accessibility + SEO
  media_type     String? // image, video, carousel
  video_url      String? // Direct video URL if article's primary media is video
  video_poster   String? // Thumbnail/poster frame for video
  video_duration Int? // Duration in seconds
  media_urls     String[] @default([]) // Multiple media items (images/videos)

  // Taxonomy
  category String?
  tags     String[] @default([])
  topic    String? // Broad topic bucket: finance, tech, politics, etc.

  // SEO
  meta_title       String? // Falls back to title if null
  meta_description String? // 155 chars max
  canonical_url    String? // For syndicated / republished content

  // Open Graph (social link previews)
  og_title       String?
  og_description String?
  og_image       String? // Often same as cover_image but can differ

  // Twitter Card
  twitter_card        String? @default("summary_large_image")
  twitter_title       String?
  twitter_description String?

  // Publishing
  status       MediaPostStatus @default(DRAFT)
  is_featured  Boolean         @default(false)
  is_breaking  Boolean         @default(false)
  is_sponsored Boolean         @default(false)
  sponsor_name String?
  sponsor_url  String?

  published_at DateTime? @db.Timestamptz()
  scheduled_at DateTime? @db.Timestamptz()

  // Reading experience
  read_time  Int    @default(3) // estimated minutes
  language   String @default("en")
  word_count Int?

  // AI generation audit trail
  ai_generated Boolean @default(false)
  ai_provider  String? // anthropic, openai
  ai_model     String? // claude-sonnet-4-6
  ai_prompt    String? // exact prompt used — critical for improvement loop
  ai_score     Float? // 0–1 quality/relevance score from filter step
  source_url   String? // original news source credited
  source_name  String? // "Reuters", "TechCrunch", etc.

  // Article analytics
  views            Int    @default(0)
  unique_views     Int    @default(0)
  shares           Int    @default(0)
  read_completions Int    @default(0) // reached 90% scroll depth
  avg_read_time    Float? // actual seconds spent reading (avg)
  bounce_rate      Float? // % who left without scrolling past fold

  // Newsletter tracking
  in_newsletter      Boolean   @default(false)
  newsletter_sent_at DateTime? @db.Timestamptz()
  newsletter_opens   Int       @default(0)
  newsletter_clicks  Int       @default(0)

  // RSS
  rss_guid String? @unique // stable GUID for RSS feed item

  // Relations
  socialPosts    SocialMediaPost[] // manual social posts linked to this article
  generatedPosts N8nGeneratedPost[] // AI-generated social captions for this article

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([topic])
  @@index([is_featured])
  @@index([is_breaking])
  @@index([published_at(sort: Desc)])
  @@index([ai_generated])
  @@index([n8nArticleId])
  @@index([authorId])
  @@index([in_newsletter])
  @@index([rss_guid])
  @@map("media_posts")
}

// ─────────────────────────────────────────────
// NEWSLETTER SUBSCRIBERS (via Notify sync)
// ─────────────────────────────────────────────

model NewsletterSubscriber {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?
  phone String? // for WhatsApp via Notify

  // Notify sync
  notify_contact_id String?   @unique // ID in your Notify product
  notify_synced_at  DateTime? @db.Timestamptz()

  // Tags for segmentation
  tags String[] @default([]) // ["media-subscriber", "tech", "finance"]

  // Status
  status     String  @default("active") // active, unsubscribed, bounced
  source     String? // "article-widget", "homepage", "import", "notify"
  ip_address String?
  user_agent String?

  // Engagement
  total_emails_sent    Int       @default(0)
  total_emails_opened  Int       @default(0)
  total_emails_clicked Int       @default(0)
  last_opened_at       DateTime? @db.Timestamptz()
  last_clicked_at      DateTime? @db.Timestamptz()

  // Welcome drip
  drip_step       Int       @default(0) // 0=not started, 1=welcome sent, 2=day2, 3=day5
  drip_completed  Boolean   @default(false)
  drip_started_at DateTime? @db.Timestamptz()

  subscribed_at   DateTime  @default(now()) @db.Timestamptz()
  unsubscribed_at DateTime? @db.Timestamptz()
  created_at      DateTime  @default(now()) @db.Timestamptz()
  updated_at      DateTime  @updatedAt @db.Timestamptz()

  @@index([email])
  @@index([status])
  @@index([notify_contact_id])
  @@index([drip_step])
  @@index([subscribed_at])
  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────
// NEWSLETTER CAMPAIGNS
// ─────────────────────────────────────────────

model NewsletterCampaign {
  id String @id @default(uuid())

  // Identity
  subject      String
  preview_text String?
  type         String  @default("digest") // digest, breaking, drip, manual

  // Content
  html_content String
  text_content String?

  // Notify sync
  notify_campaign_id String?   @unique
  notify_sent_at     DateTime? @db.Timestamptz()

  // Articles included (slugs)
  article_ids String[] @default([]) // MediaPost IDs included in this campaign

  // Status
  status       String    @default("draft") // draft, scheduled, sent, failed
  scheduled_at DateTime? @db.Timestamptz()
  sent_at      DateTime? @db.Timestamptz()

  // Metrics
  recipients   Int @default(0)
  opens        Int @default(0)
  clicks       Int @default(0)
  unsubscribes Int @default(0)
  bounces      Int @default(0)

  // AI generation
  ai_generated Boolean @default(false)
  ai_prompt    String?

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  @@index([status])
  @@index([type])
  @@index([sent_at])
  @@index([notify_campaign_id])
  @@map("newsletter_campaigns")
}

// ─────────────────────────────────────────────
// MEDIA ANALYTICS (per-article daily rollup)
// ─────────────────────────────────────────────

model MediaAnalytics {
  id          String   @id @default(uuid())
  mediaPostId String
  date        DateTime @db.Date // daily rollup

  // Traffic
  views            Int @default(0)
  unique_views     Int @default(0)
  read_completions Int @default(0)

  // Source breakdown
  views_direct     Int @default(0)
  views_search     Int @default(0)
  views_social     Int @default(0)
  views_newsletter Int @default(0)
  views_referral   Int @default(0)

  // Social shares per platform
  shares_facebook Int @default(0)
  shares_twitter  Int @default(0)
  shares_linkedin Int @default(0)
  shares_whatsapp Int @default(0)
  shares_other    Int @default(0)

  created_at DateTime @default(now()) @db.Timestamptz()
  updated_at DateTime @updatedAt @db.Timestamptz()

  @@unique([mediaPostId, date])
  @@index([mediaPostId])
  @@index([date])
  @@map("media_analytics")
}

// ─────────────────────────────────────────────
// AI USAGE LEDGER
// ─────────────────────────────────────────────

model AiUsageLog {
  id String @id @default(uuid())

  node      String // 'claude' | 'chatGpt'
  model     String
  resource  String
  operation String

  user_id    String?
  session_id String?
  request_id String?

  input_tokens       Int @default(0)
  output_tokens      Int @default(0)
  cache_read_tokens  Int @default(0)
  cache_write_tokens Int @default(0)

  // Integer money: micro-USD. Never a float.
  cost_micro_usd BigInt @default(0)

  latency_ms Int     @default(0)
  success    Boolean @default(true)
  cached     Boolean @default(false)
  error_code String?

  created_at DateTime @default(now()) @db.Timestamptz()

  @@index([user_id, created_at])
  @@index([model, created_at])
  @@index([node, created_at])
  @@map("ai_usage_logs")
}

// ─────────────────────────────────────────────
// CAROUSEL AGENT
// ─────────────────────────────────────────────

enum PostDraftStatus {
  drafting
  rendered
  awaiting_approval
  approved
  scheduled
  rejected
  failed
}

model PostDraft {
  id     String @id @default(uuid())
  userId String

  topic       String
  format      String  @default("post") // post | story
  serviceLine String?
  offer       String?
  audience    String?

  status PostDraftStatus @default(drafting)

  // The PostSpec handed to the render service, stored verbatim so a re-render
  // reproduces the approved artwork rather than a fresh generation.
  spec Json

  caption  String?
  hashtags String[] @default([])

  // Policy statements the copy agent made. Nothing publishes until these are signed off.
  claims         String[] @default([])
  claimsApproved Boolean  @default(false)

  auditReport Json?
  auditPassed Boolean @default(false)

  slideUrls String[] @default([])

  approvedBy String?
  approvedAt DateTime? @db.Timestamptz()

  scheduledAt   DateTime? @db.Timestamptz()
  socialPostIds String[]  @default([])

  aiProvider      String?
  aiModel         String?
  costMicroUsd    BigInt  @default(0)
  generationTries Int     @default(0)

  errorMessage String?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([userId, createdAt])
  @@index([status])
  @@map("post_drafts")
}

/// A photograph placed in a brand's library. A brand with none falls back to the
/// whole approved pool, so an unassigned library keeps working as a shared one.
model AccountGroupAsset {
  id      String       @id @default(uuid())
  groupId String
  group   AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  assetId String
  asset   BrandAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([groupId, assetId])
  @@index([assetId])
  @@map("account_group_assets")
}

/// A named set of photographs — "Repair bench shots", "Office lifestyle".
/// A brand is assigned whole sets; art direction rotates through their images.
model BrandAsset {
  id String @id @default(uuid())

  userId String?

  name        String
  description String?

  kind String @default("photo")

  /// A set is usable once it is approved; every image inside it comes with it.
  approved Boolean @default(false)

  images BrandAssetImage[]
  groups AccountGroupAsset[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([userId])
  @@index([kind, approved])
  @@map("brand_assets")
}

/// One photograph inside a set, tagged and framed on its own.
model BrandAssetImage {
  id      String     @id @default(uuid())
  assetId String
  asset   BrandAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId String?

  url       String
  /// Stable name for this image. Also what earlier versions called the reference.
  reference String

  subjects    String[] @default([])
  hasPerson   Boolean  @default(false)
  subjectSide String?
  brightness  String?

  usageCount Int       @default(0)
  lastUsedAt DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, reference])
  @@index([assetId])
  @@index([userId])
  @@index([lastUsedAt])
  @@map("brand_asset_images")
}

// ─────────────────────────────────────────────
// ACCOUNT GROUPS (brand / business workspaces)
// ─────────────────────────────────────────────

enum AutomationMode {
  manual
  autopilot
}

enum AgentRunStatus {
  running
  succeeded
  failed
  skipped
}

enum AgentStepStatus {
  pending
  running
  succeeded
  failed
  skipped
}

/// A brand or business a user runs. Holds the installed pages and accounts
/// across every platform, plus the cadence its agents post on.
model AccountGroup {
  id     String @id @default(uuid())
  userId String

  name        String
  slug        String
  description String?
  color       String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  autopilotEnabled Boolean @default(false)
  // Weekdays as 0=Sunday..6=Saturday, matching POST_SLOT_WEEKDAYS.
  slotWeekdays     String  @default("2,5")
  slotHour         Int     @default(9)
  timezone         String  @default("UTC")
  postsPerRun      Int     @default(1)

  // The brief the agents work from when nobody hands them one.
  topics        String[] @default([])
  serviceLine   String?
  audience      String?
  defaultFormat String   @default("post")
  /// Frames per post. Null takes the house length for the format — five for a
  /// carousel, three for a story.
  slideCount    Int?

  members   AccountGroupMember[]
  agentRuns AgentRun[]
  assets    AccountGroupAsset[]
  stories   Story[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([userId, slug])
  @@index([userId, isActive])
  @@index([autopilotEnabled])
  @@map("account_groups")
}

/// One installed page or account placed in a group. `isActive` mutes a page for
/// a season without dropping it out of the group.
model AccountGroupMember {
  id      String       @id @default(uuid())
  groupId String
  group   AccountGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  accountId String
  account   SocialMediaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([groupId, accountId])
  @@index([accountId])
  @@index([groupId, isActive])
  @@map("account_group_members")
}

/// How the whole workspace runs: by hand, or with the agents driving.
model AutomationPolicy {
  id     String @id @default(uuid())
  userId String @unique

  mode AutomationMode @default(manual)

  // Autopilot releases a rendered draft straight to the publish cron. Manual
  // mode holds every draft in review until someone signs it off.
  autoPublish    Boolean   @default(true)
  defaultGroupId String?
  maxPostsPerDay Int       @default(3)
  pausedUntil    DateTime? @db.Timestamptz()
  lastRunAt      DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("automation_policies")
}

/// One pass of one agent, so the automation view reports what actually ran.
model AgentRun {
  id     String @id @default(uuid())
  userId String

  groupId String?
  group   AccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  agent   String
  trigger String
  status  AgentRunStatus @default(running)

  topic            String?
  draftId          String?
  postIds          String[] @default([])
  accountsTargeted Int      @default(0)

  errorMessage String?

  steps AgentRunStep[]

  startedAt  DateTime  @default(now()) @db.Timestamptz()
  finishedAt DateTime? @db.Timestamptz()

  @@index([userId, startedAt])
  @@index([groupId, startedAt])
  @@index([status])
  @@map("agent_runs")
}

/// One stage of one run. Seeded up front so the UI can draw the whole pipeline
/// before any of it has happened, then filled in as each stage completes.
model AgentRunStep {
  id    String   @id @default(uuid())
  runId String
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  key      String
  label    String
  sequence Int

  status AgentStepStatus @default(pending)

  detail       String?
  errorMessage String?

  startedAt  DateTime? @db.Timestamptz()
  finishedAt DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([runId, key])
  @@index([runId, sequence])
  @@map("agent_run_steps")
}

/// A day's standing for one connected account: followers, reach, profile views.
/// Per account per day, so one call covers every post that account carries.
model SocialAccountSnapshot {
  id        String @id @default(uuid())
  accountId String

  date     DateTime @db.Date
  platform String

  followers    Int @default(0)
  follows      Int @default(0)
  postsCount   Int @default(0)
  reach        Int @default(0)
  impressions  Int @default(0)
  profileViews Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([accountId, date])
  @@index([accountId, date])
  @@index([platform])
  @@map("social_account_snapshots")
}

// ─────────────────────────────────────────────
// STUDIO — ANIMATION PRODUCTION
// ─────────────────────────────────────────────

enum ProductionStatus {
  DRAFT
  PLANNING
  SCRIPT_READY
  ASSETS_GENERATING
  ASSETS_READY
  AUDIO_GENERATING
  AUDIO_READY
  ANIMATION_READY
  RENDERING
  POST_PROCESSING
  QUALITY_CHECK
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  RETRYING
  CANCELLED
}

enum AnimationMode {
  TWO_D
  HYBRID
  THREE_D
  AI_VIDEO
}

enum StudioJobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum StudioAssetKind {
  CHARACTER
  ENVIRONMENT
  PROP
  EFFECT
  TEXTURE
  IMAGE
  AUDIO
  MUSIC
  SFX
  VIDEO
}

enum RenderProfile {
  PREVIEW
  DRAFT
  PRODUCTION
  PREMIUM
}

enum VariantFormat {
  LANDSCAPE_16_9
  VERTICAL_9_16
  PORTRAIT_4_5
  SQUARE_1_1
}

enum QualityVerdict {
  PASSED
  WARNING
  FAILED
}

enum ApprovalStage {
  STORY
  ASSETS
  FINAL_VIDEO
  PUBLISHING
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum AudioTrackKind {
  VO
  DIALOGUE
  SFX
  AMBIENCE
  MUSIC
  MASTER
}

enum SubtitleFormat {
  SRT
  ASS
  VTT
}

/// One end-to-end animated production: an idea in, platform-ready videos out.
/// Every stage writes back here; nothing about a production is inferred from logs.
model Production {
  id     String @id @default(uuid())
  userId String

  title                 String?
  idea                  String
  genre                 String?
  language              String           @default("en")
  audience              String?
  visualStyle           String           @default("cinematic stylized 3D")
  narrationStyle        String?
  animationMode         AnimationMode    @default(TWO_D)
  targetDurationSeconds Int              @default(60)
  platforms             SocialPlatform[] @default([])
  formats               VariantFormat[]  @default([])
  contentRestrictions   String[]         @default([])
  renderProfile         RenderProfile    @default(PRODUCTION)

  autoApprove Boolean @default(false)

  status  ProductionStatus @default(DRAFT)
  version Int              @default(1)

  /// Set by the caller for externally triggered creates so a retried request
  /// resumes the same production instead of starting a second one.
  idempotencyKey String? @unique

  /// Model names, versions, seeds, prompt template versions and engine versions
  /// captured at each stage. A production is only reproducible if this is complete.
  reproducibility Json?
  metadata        Json?

  errorMessage String?
  failedStage  String?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  story          StudioStory?
  characters     StudioCharacter[]
  environments   StudioEnvironment[]
  props          StudioProp[]
  assets         StudioAsset[]
  scenes         StudioScene[]
  audioTracks    StudioAudioTrack[]
  audioJobs      StudioAudioJob[]
  animationJobs  StudioAnimationJob[]
  renderJobs     StudioRenderJob[]
  renderOutputs  StudioRenderOutput[]
  subtitles      StudioSubtitle[]
  thumbnails     StudioThumbnail[]
  variants       StudioPlatformVariant[]
  publishingJobs StudioPublishingJob[]
  qualityChecks  StudioQualityCheck[]
  approvals      StudioApproval[]
  events         StudioWorkflowEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("studio_productions")
}

model StudioStory {
  id           String     @id @default(uuid())
  productionId String     @unique
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  title    String
  logline  String
  synopsis String?

  /// The validated Story contract exactly as the director agent produced it.
  spec       Json
  screenplay Json?

  targetDurationSeconds Int @default(60)
  version               Int @default(1)

  moderationVerdict String?
  moderationReport  Json?

  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("studio_stories")
}

/// A character's stable identity. Scenes reference the character, never a
/// per-scene redescription — that is what keeps a face the same across shots.
model StudioCharacter {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  slug String
  name String

  activeVersion Int      @default(1)
  status        String   @default("active")
  metadata      Json?

  versions StudioCharacterVersion[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, slug])
  @@map("studio_characters")
}

model StudioCharacterVersion {
  id          String          @id @default(uuid())
  characterId String
  character   StudioCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  version Int

  /// The validated CharacterBible contract.
  spec       Json
  appearance Json?

  /// Object storage keys for the model, rig, materials, expressions.
  assetKeys String[] @default([])
  checksum  String?

  /// Generator model, version, seed, prompt and parameters for reproducibility.
  generator Json?

  status    String   @default("ready")
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([characterId, version])
  @@map("studio_character_versions")
}

model StudioEnvironment {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  slug String
  name String

  activeVersion Int    @default(1)
  status        String @default("active")
  metadata      Json?

  versions StudioEnvironmentVersion[]
  scenes   StudioScene[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, slug])
  @@map("studio_environments")
}

model StudioEnvironmentVersion {
  id            String            @id @default(uuid())
  environmentId String
  environment   StudioEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  version Int

  spec      Json
  assetKeys String[] @default([])
  checksum  String?
  generator Json?

  status    String   @default("ready")
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([environmentId, version])
  @@map("studio_environment_versions")
}

model StudioProp {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  slug String
  name String

  spec      Json
  assetKeys String[] @default([])
  version   Int      @default(1)
  status    String   @default("ready")
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, slug])
  @@map("studio_props")
}

/// Any generated or library file the pipeline produced. Deduplicated by content
/// hash so the same prompt and seed never pays for a second generation.
model StudioAsset {
  id           String      @id @default(uuid())
  productionId String?
  production   Production? @relation(fields: [productionId], references: [id], onDelete: Cascade)

  kind StudioAssetKind
  slug String

  storageKey String
  mimeType   String
  bytes      Int     @default(0)
  checksum   String
  width      Int?
  height     Int?

  /// Model, model version, prompt, negative prompt, seed and parameters.
  generator Json?

  licenseId String?
  license   StudioModelLicense? @relation(fields: [licenseId], references: [id])

  activeVersion Int    @default(1)
  status        String @default("ready")
  metadata      Json?

  versions StudioAssetVersion[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([checksum, kind])
  @@index([productionId, kind])
  @@map("studio_assets")
}

model StudioAssetVersion {
  id      String      @id @default(uuid())
  assetId String
  asset   StudioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  version    Int
  storageKey String
  checksum   String
  bytes      Int    @default(0)
  generator  Json?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([assetId, version])
  @@map("studio_asset_versions")
}

model StudioScene {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  index   Int
  sceneId String

  durationSeconds Float @default(0)

  environmentId String?
  environment   StudioEnvironment? @relation(fields: [environmentId], references: [id])

  /// The validated Scene contract — the contract between the agents and the engine.
  spec Json

  /// hash(scene spec + asset versions + engine version + render profile).
  /// An unchanged key means the previous render is reused instead of re-rendered.
  cacheKey String?

  status  StudioJobStatus @default(PENDING)
  version Int             @default(1)

  metadata Json?

  shots         StudioShot[]
  audioTracks   StudioAudioTrack[]
  audioJobs     StudioAudioJob[]
  animationJobs StudioAnimationJob[]
  renderJobs    StudioRenderJob[]
  renderOutputs StudioRenderOutput[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, sceneId])
  @@index([productionId, index])
  @@map("studio_scenes")
}

model StudioShot {
  id      String      @id @default(uuid())
  sceneId String
  scene   StudioScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  index  Int
  shotId String

  durationSeconds Float @default(0)

  camera     Json
  characters Json?
  audio      Json?
  spec       Json

  status   StudioJobStatus @default(PENDING)
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([sceneId, shotId])
  @@index([sceneId, index])
  @@map("studio_shots")
}

/// Audio stays on separate stems until final mastering, so a music change never
/// forces the narration to be regenerated.
model StudioAudioTrack {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  sceneId String?
  scene   StudioScene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  kind AudioTrackKind

  storageKey      String
  durationSeconds Float   @default(0)
  loudnessLufs    Float?
  peakDb          Float?
  bytes           Int     @default(0)
  checksum        String?

  speaker String?
  voice   Json?

  /// Word and segment timestamps from transcription, used for subtitles and lip sync.
  transcript Json?
  visemes    Json?

  generator Json?

  status   StudioJobStatus @default(PENDING)
  version  Int             @default(1)
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, kind])
  @@map("studio_audio_tracks")
}

model StudioAudioJob {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  sceneId String?
  scene   StudioScene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  kind String

  status   StudioJobStatus @default(PENDING)
  attempts Int             @default(0)

  idempotencyKey String? @unique

  payload Json
  result  Json?

  worker     String?
  errorCode  String?
  error      String?
  durationMs Int?

  startedAt   DateTime? @db.Timestamptz()
  completedAt DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, status])
  @@map("studio_audio_jobs")
}

model StudioAnimationJob {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  sceneId String
  scene   StudioScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  mode   AnimationMode
  engine String

  status   StudioJobStatus @default(PENDING)
  attempts Int             @default(0)

  idempotencyKey String? @unique

  payload Json
  result  Json?

  worker     String?
  errorCode  String?
  error      String?
  durationMs Int?

  startedAt   DateTime? @db.Timestamptz()
  completedAt DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, status])
  @@map("studio_animation_jobs")
}

model StudioRenderJob {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  sceneId String?
  scene   StudioScene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  engine  String
  profile RenderProfile @default(PRODUCTION)

  status   StudioJobStatus @default(PENDING)
  attempts Int             @default(0)

  idempotencyKey String? @unique
  cacheKey       String?

  payload Json
  result  Json?

  worker     String?
  errorCode  String?
  error      String?
  durationMs Int?

  startedAt   DateTime? @db.Timestamptz()
  completedAt DateTime? @db.Timestamptz()

  outputs StudioRenderOutput[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, status])
  @@index([cacheKey])
  @@map("studio_render_jobs")
}

model StudioRenderOutput {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  sceneId String?
  scene   StudioScene? @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  jobId String?
  job   StudioRenderJob? @relation(fields: [jobId], references: [id])

  kind String @default("scene")

  storageKey      String
  container       String  @default("mp4")
  videoCodec      String?
  audioCodec      String?
  width           Int
  height          Int
  fps             Float
  durationSeconds Float
  bytes           Int     @default(0)
  checksum        String?
  hasAudio        Boolean @default(false)

  profile  RenderProfile @default(PRODUCTION)
  status   String        @default("ready")
  metadata Json?

  variants StudioPlatformVariant[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, kind])
  @@map("studio_render_outputs")
}

/// Timings come from the generated audio, never from an estimate on script length.
model StudioSubtitle {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  format   SubtitleFormat
  language String         @default("en")

  storageKey String
  cues       Json?

  sourceTrackId String?
  burnedIn      Boolean @default(false)

  metadata Json?

  variants StudioPlatformVariant[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, format])
  @@map("studio_subtitles")
}

model StudioThumbnail {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  storageKey String
  width      Int
  height     Int
  bytes      Int    @default(0)

  candidateIndex Int     @default(0)
  score          Float?
  scoreReport    Json?
  selected       Boolean @default(false)

  prompt    String?
  generator Json?

  variants StudioPlatformVariant[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, selected])
  @@map("studio_thumbnails")
}

model StudioPlatformVariant {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  format   VariantFormat

  renderOutputId String?
  renderOutput   StudioRenderOutput? @relation(fields: [renderOutputId], references: [id])

  subtitleId String?
  subtitle   StudioSubtitle? @relation(fields: [subtitleId], references: [id])

  thumbnailId String?
  thumbnail   StudioThumbnail? @relation(fields: [thumbnailId], references: [id])

  storageKey String?

  title       String?
  description String?
  tags        String[] @default([])
  hashtags    String[] @default([])

  status   StudioJobStatus @default(PENDING)
  metadata Json?

  publishingJobs StudioPublishingJob[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, platform, format])
  @@map("studio_platform_variants")
}

/// Publishing never blocks an HTTP request and never runs twice for one variant —
/// the idempotency key is what a worker retry checks before it uploads again.
model StudioPublishingJob {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  variantId String
  variant   StudioPlatformVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  platform      SocialPlatform
  integrationId String?
  accountRef    String?

  status   StudioJobStatus @default(PENDING)
  attempts Int             @default(0)

  idempotencyKey String @unique

  externalId  String?
  externalUrl String?

  scheduledFor DateTime? @db.Timestamptz()
  publishedAt  DateTime? @db.Timestamptz()

  errorCode String?
  error     String?
  response  Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@index([productionId, status])
  @@index([status, scheduledFor])
  @@map("studio_publishing_jobs")
}

/// The quality worker can reject a production outright; an APPROVED production
/// is one that passed here, not one that merely finished rendering.
model StudioQualityCheck {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  target   String
  targetId String?

  verdict QualityVerdict

  checks   Json
  failures String[] @default([])
  warnings String[] @default([])

  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([productionId, target])
  @@map("studio_quality_checks")
}

model StudioApproval {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  stage    ApprovalStage
  decision ApprovalDecision @default(PENDING)

  decidedBy String?
  reason    String?
  decidedAt DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([productionId, stage])
  @@map("studio_approvals")
}

model StudioWorkflowEvent {
  id           String     @id @default(uuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  event      String
  fromStatus ProductionStatus?
  toStatus   ProductionStatus?

  jobId   String?
  worker  String?
  attempt Int     @default(0)

  durationMs Int?
  errorCode  String?
  payload    Json?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([productionId, createdAt])
  @@map("studio_workflow_events")
}

/// "Open source" is not the same as "cleared for commercial use", so every model
/// and library asset carries its licence terms into the production record.
model StudioModelLicense {
  id String @id @default(uuid())

  name    String
  kind    String
  source  String?
  version String?

  license             String
  commercialUse       Boolean @default(false)
  attributionRequired Boolean @default(false)
  url                 String?
  notes               String?

  assets StudioAsset[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([name, version])
  @@map("studio_model_licenses")
}

// ─────────────────────────────────────────────
// STORY AGENT — EPISODIC WRITTEN STORIES
// ─────────────────────────────────────────────

enum StoryStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum StoryEpisodeStatus {
  DRAFT
  GENERATING
  READY_FOR_REVIEW
  APPROVED
  PUBLISHED
  FAILED
}

/// A series brief: the premise, voice, and promotion rules every episode is generated from.
model Story {
  id     String @id @default(uuid())
  userId String

  title    String
  premise  String
  genre    String?
  language String  @default("en")
  audience String?
  tone     String?

  coverImageUrl String?

  /// The connected brand a published episode is advertised through, via the
  /// existing post agent — the same group a Post Studio brief would target.
  /// Null falls back to the post agent's own default-brand resolution.
  groupId String?
  group   AccountGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  autoPromote          Boolean @default(false)
  autoApprovePromotion Boolean @default(false)

  status   StoryStatus @default(DRAFT)
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  episodes StoryEpisode[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("stories")
}

/// One episode of a Story: generated prose, its review state, and the promo post it produced.
model StoryEpisode {
  id      String @id @default(uuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)

  episodeNumber Int

  /// Set by the caller so a retried generate request returns the same episode
  /// instead of writing a second one and paying for a second LLM call.
  idempotencyKey String?

  title       String
  hook        String
  body        String
  cliffhanger String?

  themes          String[] @default([])
  contentWarnings String[] @default([])
  wordCount       Int      @default(0)

  /// Denormalized from StoryReadEvent — unique devices, not raw pings.
  viewCount      Int @default(0)
  completedReads Int @default(0)

  readEvents StoryReadEvent[]

  /// The caption an approved episode was (or will be) advertised with.
  promotionCaption  String?
  promotionHashtags String[] @default([])
  /// Id of the PostDraft the existing post agent created to advertise this episode.
  promotionDraftId String?
  promotionStatus  String?
  promotionError   String?

  llmProvider String?
  llmAttempts Int     @default(1)

  status      StoryEpisodeStatus @default(DRAFT)
  publishedAt DateTime?
  metadata    Json?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([storyId, episodeNumber])
  @@unique([storyId, idempotencyKey])
  @@index([storyId, episodeNumber])
  @@index([status])
  @@map("story_episodes")
}

/// An anonymous reader, identified by a random id the frontend generates and
/// keeps in localStorage. No login involved — this is what lets "have I read
/// this" survive a page reload without an account.
model ReaderDevice {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now()) @db.Timestamptz()
  lastSeenAt DateTime @updatedAt @db.Timestamptz()

  storyReads   StoryReadEvent[]
  articleReads ArticleReadEvent[]

  @@map("reader_devices")
}

/// One device's relationship to one episode: has it been opened, has it been
/// finished. `completedAt` set once and never cleared, so re-reading an
/// already-finished episode doesn't lose the original completion time.
model StoryReadEvent {
  id       String       @id @default(uuid())
  deviceId String
  device   ReaderDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  episodeId String
  episode   StoryEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false)
  viewedAt    DateTime  @default(now()) @db.Timestamptz()
  completedAt DateTime?

  @@unique([deviceId, episodeId])
  @@index([episodeId])
  @@map("story_read_events")
}

/// Same idea as StoryReadEvent, for a single-page article rather than a
/// story episode — there is no "next episode", so this only ever answers
/// "has this device read this article", not a reading-progress sequence.
model ArticleReadEvent {
  id       String       @id @default(uuid())
  deviceId String
  device   ReaderDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  articleId BigInt
  article   N8nArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false)
  viewedAt    DateTime  @default(now()) @db.Timestamptz()
  completedAt DateTime?

  @@unique([deviceId, articleId])
  @@index([articleId])
  @@map("article_read_events")
}
