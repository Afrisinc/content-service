# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Where this service is reachable; used to build absolute links it hands out.
API_BASE_URL=http://localhost:3000

# Shared with api-gateway: signs the HMAC gatewayGuard checks on every request.
# The built-in default is a placeholder and must never reach production.
SERVICE_SECRET=change-me-and-match-the-gateway

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://username:password@localhost:5432/afrisync

# ============================================
# Assets service (stores uploaded and rendered images)
# ============================================
# The render service downloads brand photos from here and refuses any host that
# resolves to a private address, so in production this must be publicly routable.
ASSETS_API_URL=http://localhost:8081
ASSETS_API_KEY=default-api-key

# Optional external agent endpoint. Empty disables it.
SM_AI_AGENT_URL=

# ============================================
# Social Media Platforms
# ============================================

# Facebook Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram Configuration
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_PAGE_ID=your_instagram_page_id

# Twitter Configuration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# LinkedIn Configuration
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# TikTok Configuration
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ============================================
# AI Content Generation (OpenAI)
# ============================================
AI_CONTENT_GENERATION_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_API_KEY=your_openai_api_key

# OpenAI Specific Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4
OPENAI_IMAGE_MODEL=dall-e-3

# Optional, read by the ChatGPT node (src/nodes/chatgpt) via chatGptCredentialsFromEnv
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Claude node (src/nodes/claude), read via claudeCredentialsFromEnv
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_BASE_URL=

# AI node runtime (memory, usage ledger, spend guard)
AI_MEMORY_TTL_SECONDS=86400
AI_MEMORY_MAX_TURNS=20
# Per-user daily cap in micro-USD (1000000 = $1). 0 disables the guard.
AI_DAILY_BUDGET_MICRO_USD=5000000
# Fold old turns into a running summary instead of dropping them (costs a model call per fold)
AI_MEMORY_SUMMARISE=false
AI_MEMORY_SUMMARY_MODEL=claude-haiku-4-5
AI_MEMORY_KEEP_RECENT_TURNS=8
AI_MEMORY_SUMMARISE_AFTER_TURNS=24

# ============================================
# Notify (transactional notifications and campaigns via @afrisinc/notify-sdk)
# ============================================
NOTIFY_API_KEY=
NOTIFY_REVIEW_CHANNELS=in_app,email
NOTIFY_DEDUPE_TTL_SECONDS=86400
DASHBOARD_URL=http://localhost:5173

# ============================================
# Daily newsletter digest (WF4)
# ============================================
NEWSLETTER_DIGEST_ENABLED=false
CRON_SCHEDULE_NEWSLETTER_DIGEST=30 6 * * *
NEWSLETTER_DIGEST_MODEL=gpt-4o
NEWSLETTER_ARTICLE_LIMIT=5
NEWSLETTER_MIN_ARTICLES=3
NEWSLETTER_RECIPIENT_TAGS=newsletter
NEWSLETTER_SEND_DELAY_MINUTES=60
NEWSLETTER_SITE_URL=https://afrisinc.com

# ============================================
# News agent — RSS ingestion (WF1) and AI enhancement (WF2)
# ============================================
NEWS_AGENT_ENABLED=false
CRON_SCHEDULE_NEWS_INGEST=*/30 * * * *
CRON_SCHEDULE_NEWS_ENHANCE=*/10 * * * *
# Optional JSON array of {"name","url","category"} — replaces the built-in feed list
NEWS_RSS_SOURCES=
NEWS_FEED_TIMEOUT_MS=10000
NEWS_FEED_ITEM_LIMIT=10
NEWS_ENHANCE_BATCH_SIZE=5
NEWS_MIN_SCORE=0.6
NEWS_TEXT_MODEL=gpt-4o
NEWS_IMAGE_MODEL=dall-e-3
NEWS_IMAGE_SIZE=1792x1024
NEWS_IMAGE_QUALITY=hd

# ============================================
# Story agent — writes the next episode of active stories while on Agents drive
# ============================================
STORY_AGENT_ENABLED=true
CRON_SCHEDULE_STORY_AGENT=0 8 * * *
STORY_AGENT_INTERVAL_HOURS=24
STORY_AGENT_MAX_PER_RUN=3

# ============================================
# AI Content Options
# ============================================
AI_CONTENT_MAX_LENGTH=500
AI_TONE=professional
AI_INCLUDE_EMOJIS=true
AI_INCLUDE_HASHTAGS=true
AI_LANGUAGE=en

# ============================================
# Authentication
# ============================================
JWT_SECRET=your_jwt_secret_key_here_must_be_very_long_and_secure
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRATION=30d

# Encrypts social media integration app secrets at rest (32+ char random string)
CONTENT_ENCRYPTION_KEY=your_32_byte_random_encryption_key_here

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Scheduled Jobs Configuration
# ============================================
ENABLE_SCHEDULED_POST_PUBLISHING=true
SCHEDULED_POST_CHECK_INTERVAL_MS=300000
CRON_SCHEDULE_POSTS=*/5 * * * *

# ============================================
# Redis Cache
# ============================================
# Leave empty to run without caching
REDIS_URL=redis://localhost:6379
SOCIAL_PAGES_CACHE_TTL_SECONDS=3600

# ── Carousel agent + render service ──────────────────────────────────────────
RENDER_SERVICE_URL=http://localhost:8090
RENDER_SERVICE_API_KEY=
RENDER_SERVICE_TIMEOUT_MS=60000
POST_AGENT_MODEL=claude-sonnet-5
# The schema asks for a concept, a caption, fifteen hashtags, the claims and up
# to ten slides. 2048 truncated that mid-object, which surfaced as "malformed
# JSON" rather than as the length problem it was.
POST_AGENT_MAX_TOKENS=8192
# Brand asset uploads. The render service refuses anything past its own ceiling,
# so there is no point accepting more here than it will take.
BRAND_ASSET_MAX_BYTES=12582912
BRAND_ASSET_MAX_FILES=40

POST_AGENT_MAX_ATTEMPTS=3
# The Anthropic SDK defaults to a ten-minute request timeout, which a few hundred
# words of post copy should never approach. A stalled call is abandoned and
# retried rather than waited out, and the whole copy stage is capped by the budget.
POST_AGENT_TIMEOUT_MS=90000
POST_AGENT_RETRIES=1
POST_AGENT_BUDGET_MS=240000
POST_AUTO_SCHEDULE=true
POST_DEFAULT_PLATFORM=instagram
POST_DEFAULT_PAGE_ID=
# 0=Sunday .. 6=Saturday
POST_SLOT_WEEKDAYS=2,5
POST_SLOT_HOUR=9

# ─── Autopilot ───
# When a workspace's automation switch is set to autopilot, the agents draft,
# render and queue on their own. Each brand group produces its batch once per
# posting day, so the tick only has to be frequent enough to catch the slot.
AUTOPILOT_ENABLED=true
CRON_SCHEDULE_AUTOPILOT=0 * * * *
# A run still marked running after this long is treated as abandoned and closed
# out, so a process that died mid-run leaves no permanent spinner in the UI.
AUTOPILOT_MAX_RUN_MINUTES=30
# How long a failed run keeps the working state (in Redis) that lets it resume
# from the stage that broke instead of paying the copy agent again.
AGENT_RUN_STATE_TTL_SECONDS=86400

# Analytics pull (reads engagement and follower counts back from the platforms)
ANALYTICS_PULL_ENABLED=true
CRON_SCHEDULE_ANALYTICS_PULL="20 * * * *"
ANALYTICS_PULL_CALL_BUDGET=120
ANALYTICS_PULL_POST_LIMIT=100
ANALYTICS_PULL_ACCOUNT_LIMIT=50
ANALYTICS_PULL_USAGE_CEILING=80

# ─────────────────────────────────────────────
# STUDIO — ANIMATION PRODUCTION
# ─────────────────────────────────────────────

STUDIO_ENABLED=false
STUDIO_WORKER_ROLE=all
STUDIO_PROMPTS_DIR=
STUDIO_REMOTION_DIR=remotion
STUDIO_REMOTION_CONCURRENCY=2

STUDIO_DEFAULT_LANGUAGE=en
STUDIO_DEFAULT_VISUAL_STYLE=cinematic stylized 3D animation
STUDIO_DEFAULT_DURATION_SECONDS=60
STUDIO_AUTO_APPROVE=false

RABBITMQ_URL=amqp://studio:studio@localhost:5672
RABBITMQ_HEARTBEAT_SECONDS=60

STUDIO_S3_ENDPOINT=http://localhost:9000
STUDIO_S3_PUBLIC_URL=
STUDIO_S3_BUCKET=animation-platform
STUDIO_S3_REGION=us-east-1
STUDIO_S3_ACCESS_KEY=studio
STUDIO_S3_SECRET_KEY=studio-secret
STUDIO_S3_FORCE_PATH_STYLE=true
STUDIO_S3_SIGNED_URL_TTL_SECONDS=21600

STUDIO_LLM_PROVIDER=ollama
STUDIO_LLM_MODEL=qwen2.5:14b-instruct
STUDIO_LLM_FALLBACK_MODEL=gpt-4o-mini
STUDIO_LLM_FALLBACK_BASE_URL=
STUDIO_LLM_TIMEOUT_MS=300000
STUDIO_LLM_TEMPERATURE=0.7
STUDIO_LLM_MAX_TOKENS=8192
STUDIO_STRUCTURED_MAX_ATTEMPTS=3
OLLAMA_BASE_URL=http://localhost:11434

COMFYUI_BASE_URL=http://localhost:8188
STUDIO_COMFY_WORKFLOW_DIR=infra/comfyui/workflows
STUDIO_COMFY_DEFAULT_WORKFLOW=sdxl_character
STUDIO_IMAGE_STEPS=28
STUDIO_IMAGE_CFG=6.5
STUDIO_IMAGE_TIMEOUT_MS=600000
STUDIO_IMAGE_POLL_MS=1500
STUDIO_CHARACTER_WIDTH=1024
STUDIO_CHARACTER_HEIGHT=1536
STUDIO_ENVIRONMENT_WIDTH=1920
STUDIO_ENVIRONMENT_HEIGHT=1088

MEDIA_WORKER_URL=http://localhost:8095
MEDIA_WORKER_API_KEY=
MEDIA_WORKER_TIMEOUT_MS=1800000
STUDIO_TTS_TIMEOUT_MS=300000
STUDIO_STT_TIMEOUT_MS=600000
STUDIO_DEFAULT_VOICE=af_heart
STUDIO_LINE_GAP_SECONDS=0.35

STUDIO_MASTER_FPS=30
STUDIO_TARGET_LUFS=-14
STUDIO_SCENE_RENDER_TIMEOUT_SECONDS=5400
STUDIO_THUMBNAIL_CANDIDATES=5
STUDIO_WATERMARK_KEY=
STUDIO_QA_MAX_BLACK_RATIO=0.02
STUDIO_QA_MAX_SILENCE_RATIO=0.35

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DEFAULT_CATEGORY_ID=1

# Workers (python side)
STUDIO_WORK_DIR=/tmp/studio
STUDIO_ASSET_ROOT=/assets
STUDIO_WORKER_PREFETCH=1
STUDIO_JOB_TIMEOUT_SECONDS=7200
BLENDER_BIN=blender
RHUBARB_BIN=rhubarb
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
STUDIO_TTS_ENGINE=kokoro
KOKORO_MODEL_PATH=/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/models/kokoro/voices-v1.0.bin
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Studio — AI video generation (Wan 2.2 via ComfyUI)
STUDIO_VIDEO_PROVIDER=comfyui-wan
STUDIO_VIDEO_MODEL=wan2.2-t2v-a14b
STUDIO_WAN_T2V_WORKFLOW=wan22_t2v
STUDIO_WAN_I2V_WORKFLOW=wan22_i2v
STUDIO_VIDEO_WIDTH=1280
STUDIO_VIDEO_HEIGHT=720
STUDIO_VIDEO_FPS=16
STUDIO_VIDEO_STEPS=20
STUDIO_VIDEO_CFG=3.5
STUDIO_VIDEO_MAX_FRAMES=81
STUDIO_VIDEO_TIMEOUT_MS=1800000
STUDIO_VIDEO_POLL_MS=3000
STUDIO_VIDEO_CONTINUITY=true
STUDIO_VIDEO_PREVIEW_ENABLED=false

# ─────────────────────────────────────────────
# STORY AGENT — episodic written stories (chatgpt -> claude -> ollama)
# ─────────────────────────────────────────────

STORY_LLM_CHATGPT_MODEL=gpt-4o
STORY_LLM_CLAUDE_MODEL=claude-sonnet-5
STORY_LLM_MAX_TOKENS=4096
STORY_LLM_TEMPERATURE=0.85
STORY_LLM_MAX_ATTEMPTS=2
STORY_PUBLIC_BASE_URL=https://afrisinc.com/media/stories
